# The repo is developed on Windows but every one of these files is consumed on
# Linux — a CRLF in deploy.sh makes the shebang line unrunnable. Force LF.
* text=auto eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.nginx     text eol=lf
*.py        text eol=lf
*.mako      text eol=lf
*.sql       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
.env.example text eol=lf
