{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run i18n:check && npm run typecheck && npm run lint",
    "deploy:server": "powershell -ExecutionPolicy Bypass -File ../deploy-to-server.ps1",
    "deploy:backend": "powershell -ExecutionPolicy Bypass -File ../deploy-backend-to-server.ps1",
    "deploy:server:all": "powershell -ExecutionPolicy Bypass -File ../deploy-all-to-server.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
