# Local development. Copy to backend/.env.
ENVIRONMENT=development
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
# DATABASE_URL defaults to SQLite at backend/var/dev.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/buqata_processes
# VAULT_MASTER_KEY=<base64 32 bytes>   (generated into var/dev-master.key if unset)
# MAIL_BACKEND=file                   (writes .eml files to var/outbox)
# REDIS_URL=redis://localhost:6379/0  (optional; the worker polls without it)
